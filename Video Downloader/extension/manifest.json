{
  "manifest_version": 3,
  "name": "OmniStream - Video Stream Downloader",
  "version": "1.1.0",
  "description": "IDM & XDM style video stream sniffer. Detects .m3u8, .mpd, .mp4 and web video streams, pre-caches HLS segments for instant download.",
  "minimum_chrome_version": "109",
  "permissions": [
    "webRequest",
    "storage",
    "tabs",
    "downloads",
    "offscreen",
    "declarativeNetRequest",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "OmniStream Video Sniffer",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
